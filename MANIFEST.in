include CHANGELOG.rst
include CONTRIBUTING.md
include helpfile.txt
include Makefile
include MANIFEST.in
include LICENSE
include qtopconf.yaml
include qtop
include README.md
include ROADMAP.rst

recursive-include qtop_py/contrib *.sh *.jdl *.html *.txt *.ref *.gif *.stdout
